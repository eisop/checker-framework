// This file uses `@Nullable` for methods in the JDK that sometimes, but not always, permit null as
// an argument.  For more discussion, see section "Conservative nullness annotations on the JDK" in
// the Checker Framework manual (https://eisop.github.io/cf/manual/#nullness-jdk-conservative).

// This file is very incomplete and should be expanded.

package java.lang.ref;

import org.checkerframework.checker.nullness.qual.Nullable;

public class WeakReference<T> extends Reference<T> {
    public WeakReference(@Nullable T referent, @Nullable ReferenceQueue<? super T> q);
}

package java.lang.invoke;

import org.checkerframework.checker.nullness.qual.Nullable;

// A VarHandle's access methods are signature-polymorphic: the arguments they accept, and the value
// they return, depend on the type of the field the handle was created for.  For a reference-typed
// field, null is a legal value, a legal expected value, and a legal result; for a primitive-typed
// field, passing null throws.  The annotated JDK takes the conservative reading and forbids null,
// which rejects correct code such as
//     REFRESHES.compareAndSet(this, null, pending)
// on a handle for a reference field.
//
// Listed here are the 19 access modes that a reference-typed field supports.  The other 12 --
// getAndAdd*, getAndBitwiseAnd*, getAndBitwiseOr* and getAndBitwiseXor* -- are defined only for
// numeric and bitwise types, so a reference can never flow through them and null is never a legal
// argument.  They are deliberately absent.
public abstract class VarHandle {
    public final native @Nullable Object get(@Nullable Object... args);

    public final native @Nullable Object getVolatile(@Nullable Object... args);

    public final native @Nullable Object getAcquire(@Nullable Object... args);

    public final native @Nullable Object getOpaque(@Nullable Object... args);

    public final native @Nullable Object compareAndExchange(@Nullable Object... args);

    public final native @Nullable Object compareAndExchangeAcquire(@Nullable Object... args);

    public final native @Nullable Object compareAndExchangeRelease(@Nullable Object... args);

    public final native @Nullable Object getAndSet(@Nullable Object... args);

    public final native @Nullable Object getAndSetAcquire(@Nullable Object... args);

    public final native @Nullable Object getAndSetRelease(@Nullable Object... args);

    public final native void set(@Nullable Object... args);

    public final native void setVolatile(@Nullable Object... args);

    public final native void setRelease(@Nullable Object... args);

    public final native void setOpaque(@Nullable Object... args);

    public final native boolean compareAndSet(@Nullable Object... args);

    public final native boolean weakCompareAndSet(@Nullable Object... args);

    public final native boolean weakCompareAndSetPlain(@Nullable Object... args);

    public final native boolean weakCompareAndSetAcquire(@Nullable Object... args);

    public final native boolean weakCompareAndSetRelease(@Nullable Object... args);
}

// MethodHandle's invocation methods are signature-polymorphic in the same way: whether an argument
// may be null depends on the parameter type of the target the handle was found for.  For a
// reference parameter null is a legal argument; for a primitive one it throws.  bindTo has the
// same shape -- it binds a value to the target's first parameter.
//
// Only the arguments are listed.  The return types are @Nullable in the annotated JDK itself,
// soundly: a reference-returning target really can return null, and invokeWithArguments is
// documented to return null for a void target.
public abstract class MethodHandle {
    public final native @Nullable Object invoke(@Nullable Object... args);

    public final native @Nullable Object invokeExact(@Nullable Object... args);

    public @Nullable Object invokeWithArguments(@Nullable Object... arguments);

    public MethodHandle bindTo(@Nullable Object x);
}
