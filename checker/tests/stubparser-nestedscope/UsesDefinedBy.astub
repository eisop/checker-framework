package stubparsernestedscope;

import stubparsernestedscope.DefinedByExample;

// DefinedByExample.Api.COMPILER's scope ("DefinedByExample.Api") is itself a FieldAccessExpr
// (scope "DefinedByExample", name "Api"), not a plain name: real JDK sources write this same
// shape as `@DefinedBy(DefinedBy.Api.COMPILER)` in
// com.sun.tools.javac.file.JavacFileManager.setPathFactory(..), where the more common
// `Api.COMPILER` form (used everywhere else `@DefinedBy` appears) is not used.
// AnnotationFileParser.findVariableElement(FieldAccessExpr) resolved a scope only as a whole --
// via Elements.getTypeElement, importedTypes, or a full match against importedConstants -- so
// "DefinedByExample.Api" never matched anything, even though "DefinedByExample" alone (the
// annotation actually imported) does. This silently dropped the annotation.
class UsesDefinedBy {
    @DefinedByExample(DefinedByExample.Api.COMPILER)
    void bar();
}
